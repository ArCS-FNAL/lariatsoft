#include "services_lariat.fcl"  
#include "anamodules_arcs.fcl"

process_name: DumpRawDigits

services:
{
  # Load the service that manages root files for histograms.
  #TFileService: { fileName: "rawDigitDDumper_%p_%tc.root" }
  RandomNumberGenerator: {} #ART native random number generator
  #message:      @local::lariat_message_services
  @table::lariat_services
}


source: {
     module_type: RootInput
     maxEvents:   10   # set to -1 for all events
}

physics: {
     analyzers: {
          rawdump: @local::arcs_rawdump
     }
     ana: [ rawdump ]
     end_paths: [ ana ]
}