#
# File:    prodcosmics_corsika_arcs.fcl
# Purpose: Generates cosmic ray events for ArCS by CORSIKA
# Author:  Jiaoyang Li (jiaoyang@fnal.gov)
# Date:    August 11, 2025
# Version: 1.0
#
# Description:
#
# CORSIKA is used to generate cosmic ray events for ArCS detector.
# No detector simulation is performed.
# 
# Input:
#  - CORSIKA database files as specified in the included CORSIKA configuration
# 
# Output:
#  - generator: includes MCTruth and MCParticle information
#
# Documentation at:
# https://cdcvs.fnal.gov/redmine/projects/sbndcode/wiki/Cosmics
#
# Changes:
# 20160817 (petrillo@fnal.gov) [v1.0]
#   stole the essentials from Roxanne Guenette and made a FHiCL file out of them
#
# 20250811 (jiaoyang@fnal.gov) [v1.0]
#   stole FHiCL from SBND. 
#

#
# service configuration
#

#include "services_lariat.fcl"

#
# module configuration
#

#include "corsika_arcs.fcl"
#include "geometry_arcs.fcl"


process_name: CosmicsGen


#
# services
#
services:
{
  # Load the service that manages root files for histograms.
  TFileService: { fileName: "hists_prodcosmics_corsika_arcs_%p-%tc.root" }
  RandomNumberGenerator: {} #ART native random number generator
  @table::lariat_simulation_services
} # services

#Start each new event with an empty event.
source:
{
  module_type: EmptyEvent
  timestampPlugin: { plugin_type: "GeneratedEventTimestamp" }
  maxEvents:   -1          # Number of events to create
  firstRun:    1           # Run number to use for this file
  firstEvent:  1           # number of first event in the file
}

#
# processing
#
physics:
{
  
  #
  # module configuration
  #
  
  producers:
  {
    
    rns:       { module_type: "RandomNumberSaver" }
    generator: @local::arcs_corsika_cmc  # see at the bottom for setting override
    
  } # producers
  
  
  #
  # path configuration
  #
  
  # simulation path
  simulate: [ rns, generator ] 
  
  # output path
  stream1:  [ out1 ]
  
  
  # art paths
  trigger_paths: [ simulate ] 
  end_paths:     [ stream1 ]  
 
} # physics


#
# output
#
outputs:
{
  out1:
  {
    module_type:       RootOutput
    fileName:         "prodcosmics_corsika_arcs_%p-%tc.root"
    dataTier:         "generated"
  }
} # outputs


#
# override
#
services.Geometry: @local::arcs_geo
services.AuxDetGeometry: @local::arcs_geo
